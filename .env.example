# Copy this file to .env and fill in real values -- .env is gitignored, this
# template is not.
#
# .env only holds what's shared/environment-specific across every module:
# the judge's NEMOTRON_* block, the common SERVICE_BASE_URL every module's
# service lives behind, and the shared DEFAULT_SERVICE_TOKEN. Everything
# module-specific -- path, TLS-verify, timeout, offline_gpt_id, and the
# request/response JSON contract -- lives in that module's
# configs/modules/<module>.yaml under a `service:` block (see
# configs/modules/open_gpt.yaml, varuna_gpt.yaml).

# --- Judge model: scores every module's (golden, generated) pairs ---
# Assumes an OpenAI-compatible /v1/chat/completions route (vLLM / NIM
# default). Change NEMOTRON_CHAT_PATH if this deployment differs.
NEMOTRON_BASE_URL=http://192.168.10.5:8100
NEMOTRON_CHAT_PATH=/v1/chat/completions
# NEMOTRON_MODEL must match what GET <base>/v1/models reports as `id` --
# it's whatever the deployment was started with, not necessarily "nemotron".
NEMOTRON_MODEL=/models
# Leave blank if the deployment doesn't require auth.
NEMOTRON_API_KEY=
NEMOTRON_VERIFY_SSL=true
# Set "false" if this vLLM deployment wasn't started with
# --tool-call-parser (it 400s on any tool_choice) -- falls back to asking
# for JSON in plain content instead of a forced tool call.
NEMOTRON_USE_TOOLS=false

# --- Model-under-test service endpoints ---
# Shared bearer token, used by any module that doesn't set its own
# service.token override in configs/modules/<module>.yaml.
DEFAULT_SERVICE_TOKEN=

# Common host every module's service lives behind. Each module's path is
# read from the first entry in that module's `endpoints:` list, e.g.
# configs/modules/varuna_gpt.yaml's `endpoints: [/varuna]` resolves to
# SERVICE_BASE_URL + /varuna. A module can still set a full `service.url`
# override in its own YAML if it doesn't live on this host.
SERVICE_BASE_URL=https://192.168.10.5
